# Literal absolute paths, no shell expansions. No credentials in this file.
CODEX_ACTION_ROOT=/absolute/path/to/pinned/codex-action-server
ACTION_SERVER_BIN=/home/linuxbrew/.linuxbrew/bin/action-server
CODEX_ACTION_TARGETS=/home/USER/.config/codex-action-server/targets.json
CODEX_ACTION_RECEIPTS=/home/USER/.local/state/codex-action-server/receipts
CODEX_ACTION_DATA=/home/USER/.local/state/codex-action-server/runtime
CODEX_ACTION_PORT=8088
CODEX_ACTION_PROFILE=operator
# Supply the same verified tools as the interactive setup, without sourcing zshrc.
PATH=/home/USER/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin

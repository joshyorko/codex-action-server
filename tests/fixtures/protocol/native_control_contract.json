      "bounded_fields": {
        "threadId": "verified thread identifier",
        "turnId": "verified active turn identifier",
        "model": "string or null",
        "effort": "non-empty string or null"
      },
      "forbidden_native_field": "modelProvider",
      "semantics": "Targets one running turn; omitted or null model/effort leaves that setting unchanged. Never emulate this with interrupt and replay."

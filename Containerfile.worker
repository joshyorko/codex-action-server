# Runtime-only worker: never copy the CAS checkout into the project workspace.
FROM ghcr.io/joshyorko/room-of-requirement:secure@sha256:0a71d1bf0a0debdad0a728d2f018a46192fe980eb321e5e8e67f1747a8ebcb6f
USER root
COPY --chmod=0755 scripts/remote/setup.sh scripts/remote/verify.sh scripts/remote/start.sh /opt/codex-worker/
RUN install -d -o vscode -g vscode /workspaces
LABEL devcontainer.metadata="[{\"name\":\"Blank Codex worker\",\"remoteUser\":\"vscode\",\"waitFor\":\"postCreateCommand\",\"postCreateCommand\":\"set -eu; test -x /bin/bash; /bin/bash /opt/codex-worker/setup.sh\",\"postStartCommand\":\"/bin/bash /opt/codex-worker/start.sh\",\"workspaceFolder\":\"/workspaces\"}]"
USER vscode
WORKDIR /workspaces

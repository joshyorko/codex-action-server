{
  "targets": {
    "local": {
      "transport": "local",
      "codex_bin": "codex"
    },
    "devsy": {
      "transport": "devsy",
      "context": "default",
      "provider": "kubernetes",
      "user": "vscode",
      "codex_bin": "/home/vscode/.local/bin/codex",
      "source": "https://github.com/joshyorko/codex-action-server.git"
    }
  }
}
